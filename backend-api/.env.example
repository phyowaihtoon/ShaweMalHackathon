NODE_ENV=development
PORT=4000

# local | supabase — switches which connection strings are used
DATABASE_TARGET=local

# Used when DATABASE_TARGET=local (DATABASE_URL is a backward-compatible alias)
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shawemal
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shawemal

# Used when DATABASE_TARGET=supabase
# SUPABASE_DATABASE_URL: session-mode pooler (prefer port 5432 on the pooler), not the anon key
# SUPABASE_DIRECT_URL: direct db host, used by prisma migrate
# sslmode=require is added automatically if missing
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=15m
JWT_ALGORITHM=HS256
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=12
UPLOAD_ROOT=
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
SEED_ADMIN_EMAIL=admin@shawemal.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=ShweMal Admin
SEED_ADMIN_PHONE=09000000001
